# Example configuration file
# Copy this file to terraform.tfvars and customize the values

bucket_name  = "my-unique-bucket-name-123456"
environment  = "production"

enable_versioning = true
sse_algorithm     = "AES256"

# For KMS encryption, uncomment and set:
# sse_algorithm = "aws:kms"
# kms_key_id    = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"

block_public_access = true

# Enable lifecycle rules to optimize costs
enable_lifecycle_rules             = true
transition_to_ia_days              = 90
transition_to_glacier_days         = 180
expiration_days                    = 365
noncurrent_version_expiration_days = 90

# Enable logging (requires a separate logging bucket)
# enable_logging  = true
# logging_bucket  = "my-logging-bucket"

tags = {
  Project     = "MyProject"
  Owner       = "DevOps Team"
  CostCenter  = "Engineering"
}